# Optional. A free NCBI key raises the NCBI rate limit (only matters if CLINVAR_NCBI_ENABLED=1).
NCBI_API_KEY=
DATABASE_URL=sqlite:///./data/variant_classifier.db

# Optional switches (all default to the values shown):
# EVIDENCE_OFFLINE=0        # 1 = cache only, no network
# GNOMAD_ENABLED=1          # 0 = skip gnomAD
# TCGA_ENABLED=1            # 0 = skip TCGA/GDC
# CLINVAR_NCBI_ENABLED=0    # 1 = also run the NCBI position search (information only, never scored)
# ACMG_SPLICE_PVS1=1        # 0 = canonical splice sites are not null variants
# ACMG_REVEL_PP3=1          # 0 = use the 3-predictor vote instead of calibrated REVEL
# ACMG_IGNORE_CLINVAR=0     # 1 = hide ClinVar from both engines (validation)
